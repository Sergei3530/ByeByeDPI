<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        android:key="byedpi_proxytest_delay"
        android:title="@string/test_delay"
        android:inputType="number"
        android:defaultValue="1"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_requests"
        android:title="@string/test_requests"
        android:inputType="number"
        android:defaultValue="1"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_limit"
        android:title="@string/test_requests_limit"
        android:inputType="number"
        android:defaultValue="20"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_timeout"
        android:title="@string/test_timeout"
        android:inputType="number"
        android:defaultValue="5"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_sni"
        android:title="@string/test_settings_sni"
        android:inputType="text"
        android:defaultValue="google.com"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="manage_domain_lists"
        android:title="@string/domain_lists"
        android:summary="@string/domain_lists_summary"
        app:fragment="io.github.romanvht.byedpi.fragments.DomainListsFragment"
        app:iconSpaceReserved="false" />

    <SwitchPreference
        android:key="byedpi_proxytest_usercommands"
        android:title="@string/test_settings_usercommands"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_commands"
        android:title="@string/test_settings_commands"
        android:enabled="false"
        android:inputType="textMultiLine"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <SwitchPreference
        android:key="byedpi_proxytest_genetic"
        android:title="@string/test_genetic_settings"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_n"
        android:title="@string/test_genetic_n"
        android:inputType="number"
        android:defaultValue="5"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_m"
        android:title="@string/test_genetic_m"
        android:inputType="number"
        android:defaultValue="3"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_d"
        android:title="@string/test_genetic_d"
        android:inputType="number"
        android:defaultValue="1"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_r"
        android:title="@string/test_genetic_r"
        android:inputType="number"
        android:defaultValue="2"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_minutes"
        android:title="@string/test_genetic_minutes"
        android:inputType="number"
        android:defaultValue="120"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_stop_k"
        android:title="@string/test_genetic_stop_k"
        android:inputType="number"
        android:defaultValue="3"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:key="byedpi_proxytest_gen_best_k"
        android:title="@string/test_genetic_best_k"
        android:inputType="number"
        android:defaultValue="10"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="byedpi_proxytest_gen_size"
        android:title="@string/test_genetic_size"
        android:selectable="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
